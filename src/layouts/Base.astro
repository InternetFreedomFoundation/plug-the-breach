---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  /** Rendered as the <title>; the site name is appended automatically. */
  bare?: boolean;
  /** Optional schema.org payload, emitted as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = 'A public record of data breaches affecting people in India, maintained by the Internet Freedom Foundation.',
  bare = false,
  jsonLd,
} = Astro.props;

const fullTitle = bare ? title : `${title} — PlugTheBreach`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const nav = [
  { href: '/breaches', label: 'Breaches' },
  { href: '/about', label: 'About' },
  { href: '/data', label: 'Data' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" />
    <meta property="og:site_name" content="PlugTheBreach" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PlugTheBreach — a public record of data breaches affecting people in India." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Resolve the theme before first paint so there is no flash.
      (function () {
        try {
          var stored = localStorage.getItem('ptb-theme');
          var theme =
            stored ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-surface focus:px-3 focus:py-2 focus:text-sm"
      >Skip to content</a
    >

    <header class="border-b border-line">
      <div
        class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-4 sm:px-6"
      >
        <a href="/" class="mr-auto font-display text-[1.05rem] font-medium tracking-tight">
          PlugTheBreach
        </a>
        <nav class="flex items-center gap-5 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'hover:text-fg',
                  path === item.href || path.startsWith(item.href + '/')
                    ? 'text-fg underline underline-offset-[5px]'
                    : 'text-muted',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-5 px-4 pb-12 pt-9 text-sm text-muted sm:px-6"
      >
        <p class="max-w-prose">
          PlugTheBreach is an initiative of the{' '}
          <a
            href="https://internetfreedom.in/"
            class="text-fg underline underline-offset-[3px]"
            target="_blank"
            rel="noreferrer">Internet Freedom Foundation</a
          >. Every record is compiled from public reporting and is cited. Nothing here is
          obtained from the breached data itself.
        </p>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="/about" class="hover:text-fg">About</a>
          <a href="/data" class="hover:text-fg">Download dataset</a>
          <a
            href="https://github.com/InternetFreedomFoundation/plug-the-breach"
            class="hover:text-fg"
            target="_blank"
            rel="noreferrer">Source &amp; corrections</a
          >
          <a
            href="https://github.com/InternetFreedomFoundation/plug-the-breach/issues/new"
            class="hover:text-fg"
            target="_blank"
            rel="noreferrer">Report a breach</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
