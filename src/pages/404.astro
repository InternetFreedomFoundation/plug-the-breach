---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <h1 class="font-display text-2xl tracking-tight">Page not found</h1>
  <p class="mt-3 max-w-prose text-[0.97rem] text-muted">
    That page does not exist. If you followed a link to a breach record, the record may
    have been renamed.
  </p>
  <p class="mt-6 text-[0.97rem]">
    <a href="/breaches" class="underline underline-offset-[3px] hover:text-accent">
      Search all breaches
    </a>
  </p>
</Base>
