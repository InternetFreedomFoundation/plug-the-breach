---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import {
  ACK_DESCRIPTIONS,
  ACK_LABELS,
  allBreaches,
  formatAffected,
  formatDate,
} from '../../lib/breaches';

export const getStaticPaths = (async () => {
  const breaches = await allBreaches();
  return breaches.map((breach) => ({ params: { slug: breach.slug }, props: { breach } }));
}) satisfies GetStaticPaths;

const { breach } = Astro.props;
const negative = breach.acknowledged === 'no' || breach.acknowledged === 'denied';

function hostOf(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
---

<Base
  title={`${breach.org} breach`}
  description={`What is publicly known about the ${breach.org} data breach: scale, exposed data, and whether it was ever acknowledged.`}
>
  <nav class="text-sm text-muted">
    <a href="/breaches" class="underline underline-offset-[4px] hover:text-fg">
      &larr; All breaches
    </a>
  </nav>

  <h1 class="mt-5 font-display text-[1.7rem] leading-tight tracking-tight sm:text-[2rem]">
    {breach.org}
  </h1>

  <dl class="mt-7 grid gap-x-8 gap-y-5 border-y border-line py-5 sm:grid-cols-3">
    <div>
      <dt class="text-[0.78rem] uppercase tracking-wide text-faint">Breach date</dt>
      <dd class="tnum mt-1 text-[1.05rem]">{formatDate(breach.date)}</dd>
    </div>
    <div>
      <dt class="text-[0.78rem] uppercase tracking-wide text-faint">People affected</dt>
      <dd class="tnum mt-1 text-[1.05rem]">{formatAffected(breach.affectedMn)}</dd>
    </div>
    <div>
      <dt class="text-[0.78rem] uppercase tracking-wide text-faint">Status</dt>
      <dd class:list={['mt-1 text-[1.05rem]', negative && 'text-accent']}>
        {ACK_LABELS[breach.acknowledged]}
      </dd>
      <dd class="mt-1 text-[0.82rem] leading-snug text-faint">
        {ACK_DESCRIPTIONS[breach.acknowledged]}
      </dd>
    </div>
  </dl>

  <div class="mt-9 max-w-prose space-y-8">
    {
      breach.exposed.length > 0 && (
        <section>
          <h2 class="font-display text-[1.05rem]">Data exposed</h2>
          <ul class="mt-3 space-y-1.5 text-[0.97rem] text-muted">
            {breach.exposed.map((item) => (
              <li class="flex gap-2.5">
                <span aria-hidden="true" class="text-faint">
                  —
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      breach.notes && (
        <section>
          <h2 class="font-display text-[1.05rem]">What happened</h2>
          <div
            class="richtext mt-3 text-[0.97rem] leading-relaxed text-muted"
            set:html={breach.notes}
          />
        </section>
      )
    }

    {
      breach.statement && (
        <section>
          <h2 class="font-display text-[1.05rem]">Notice or statement</h2>
          <div
            class="richtext mt-3 text-[0.97rem] leading-relaxed text-muted"
            set:html={breach.statement}
          />
        </section>
      )
    }

    {
      breach.redressal && (
        <section>
          <h2 class="font-display text-[1.05rem]">Grievance redressal</h2>
          <div
            class="richtext mt-3 text-[0.97rem] leading-relaxed text-muted"
            set:html={breach.redressal}
          />
        </section>
      )
    }

    <section>
      <h2 class="font-display text-[1.05rem]">Sources</h2>
      {
        breach.sources.length > 0 ? (
          <ul class="mt-3 space-y-2 text-[0.95rem]">
            {breach.sources.map((url) => (
              <li>
                <a
                  href={url}
                  rel="noreferrer nofollow"
                  target="_blank"
                  class="underline underline-offset-[3px] hover:text-accent"
                >
                  {hostOf(url)}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-3 text-[0.95rem] text-muted">
            No source URL was recorded for this incident.{' '}
            <a
              href="https://github.com/InternetFreedomFoundation/plug-the-breach"
              class="underline underline-offset-[3px]"
              target="_blank"
              rel="noreferrer"
            >
              Send us one
            </a>
            .
          </p>
        )
      }
    </section>

    <section class="border-t border-line pt-6 text-[0.85rem] leading-relaxed text-faint">
      <p>
        Something wrong or missing on this record?{' '}
        <a
          href={`https://github.com/InternetFreedomFoundation/plug-the-breach/issues/new?title=${encodeURIComponent(
            `Correction: ${breach.org} (${breach.slug})`,
          )}`}
          class="underline underline-offset-[3px]"
          target="_blank"
          rel="noreferrer">Open an issue</a
        >. Record ID <code class="text-muted">{breach.slug}</code>.
      </p>
    </section>
  </div>
</Base>

<style>
  /* Editor fields may contain basic HTML; legacy values are plain text.
     Tailwind's preflight strips list styling, so restore it for the injected
     markup only (:global — set:html children carry no scope attribute). */
  .richtext :global(:where(p, ul, ol, blockquote)) {
    margin-block: 0.75rem;
  }
  .richtext :global(:where(p, ul, ol, blockquote):first-child) {
    margin-top: 0;
  }
  .richtext :global(:where(p, ul, ol, blockquote):last-child) {
    margin-bottom: 0;
  }
  .richtext :global(:where(ul)) {
    list-style: disc;
  }
  .richtext :global(:where(ol)) {
    list-style: decimal;
  }
  .richtext :global(:where(ul, ol)) {
    padding-left: 1.4rem;
  }
  .richtext :global(:where(li)) {
    margin-block: 0.25rem;
  }
  .richtext :global(:where(a)) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
